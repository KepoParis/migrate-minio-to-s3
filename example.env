# Copy this file per environment (e.g. envs/prod.env, envs/staging.env) and adapt.
# Credentials are NOT stored here: export SCW_ACCESS_KEY / SCW_SECRET_KEY before the first run.

KUBE_CONTEXT=                        # kubectl context of this environment (empty = current context)
NAMESPACE=dso-gitlab
PVC_NAME=gitlab-minio

BUCKET_PREFIX=dso-gitlab             # destination = <BUCKET_PREFIX>-<suffix from buckets.map>
BUCKET_MAP=buckets.map               # relative to migrate.sh, or absolute path
CREATE_BUCKETS=true                  # false if buckets are created by Terraform / console

SCW_REGION=fr-par
SCW_ENDPOINT=s3.fr-par.scw.cloud
SCW_SECRET_NAME=minio-migration-scw  # k8s Secret holding the Scaleway keys
SCW_CA_CERT=                         # PEM of the CA / self-signed cert of the endpoint (relative to migrate.sh, or absolute)
SCW_SKIP_TLS_VERIFY=false            # true = do not verify the endpoint certificate (last resort)

RCLONE_IMAGE=rclone/rclone:1.68.2
RUN_AS_UID=1000                      # UID owning the MinIO files (chart default: 1000)
TRANSFERS=8                          # parallel file transfers
VERIFY_FLAGS=                        # e.g. --size-only for a faster (weaker) verify
NODE_NAME=                           # auto-detected from the VolumeAttachment when empty
